{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Webtoon Translator",
  "version": "0.1.0",
  "identifier": "com.deivide.webtoontranslator",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Webtoon Translator",
        "url": "index.html",
        "width": 420,
        "height": 680,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
