    <!-- Permissões (explicadas antes do aviso do Android) -->
    <string name="permission_overlay_title">Permitir aparecer sobre outros apps</string>
    <string name="permission_overlay_body">O ícone flutuante fica por cima do seu app de webtoon. Na próxima tela, encontre o Webtoon Translator na lista e ative "Aparecer sobre outros apps".</string>
    <string name="permission_capture_title">Permitir captura da tela</string>
    <string name="permission_capture_body">O app lê o texto do balão que você seleciona. Na próxima tela, escolha "Tela inteira" e toque em "Compartilhar tela".

Nada é gravado nem enviado além do recorte do balão, que vai pro OCR no próprio celular; só o texto lido vai pra IA. Enquanto o tradutor estiver ligado, o Android mostra um aviso de compartilhamento de tela.</string>
    <string name="permission_continue">Continuar</string>
